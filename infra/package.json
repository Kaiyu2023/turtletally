{
  "name": "@turtle-tally/infra",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "oxlint --type-aware --deny-warnings --report-unused-disable-directives bin lib test",
    "typecheck": "tsc --noEmit --pretty false",
    "test": "npm run build && node --test dist/test/foundation-stack.test.js",
    "synth": "npm run build && cdk synth --quiet"
  },
  "dependencies": {
    "aws-cdk-lib": "2.265.0",
    "constructs": "10.8.1"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "aws-cdk": "2.1137.0",
    "cdk-nag": "3.0.2",
    "oxlint": "1.78.0",
    "oxlint-tsgolint": "7.0.2001",
    "typescript": "7.0.2"
  }
}
